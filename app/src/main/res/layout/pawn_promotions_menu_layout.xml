<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_a_piece"
            android:textColor="@color/black"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/black_border"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintHeight_min="100dp">

            <ImageView
                android:id="@+id/promotions_queen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_queen_w"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/promotions_bishop"
                android:background="@drawable/black_border"/>

            <ImageView
                android:id="@+id/promotions_bishop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_bishop_w"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/promotions_queen"
                app:layout_constraintEnd_toStartOf="@+id/promotions_rook"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/black_border"/>

            <ImageView
                android:id="@+id/promotions_rook"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_rook_w"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/promotions_bishop"
                app:layout_constraintEnd_toStartOf="@+id/promotions_knight"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/black_border"/>

            <ImageView
                android:id="@+id/promotions_knight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_knight_w"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/promotions_rook"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/black_border"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
